{
  "name": "dhaka-smart-city-corporation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node -e \"try { require('fs').rmSync('frontend/.next', { recursive: true, force: true }); require('fs').rmSync('.next', { recursive: true, force: true }); } catch (e) {}\"",
    "postinstall": "node scripts/patch-font-loader.mjs",
    "predev": "npm run clean && node scripts/patch-font-loader.mjs",
    "dev": "next dev frontend",
    "prebuild": "npm run clean && node scripts/patch-font-loader.mjs && node scripts/verify-css.mjs",
    "build": "next build frontend",
    "start": "next start frontend",
    "lint": "eslint frontend && node scripts/verify-css.mjs",
    "verify:css": "node scripts/verify-css.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@types/google.maps": "^3.67.0",
    "@vis.gl/react-google-maps": "^1.10.2",
    "autoprefixer": "^10.4.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.4.9",
    "postcss": "^8.5.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^3.11.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.0.8",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  }
}
